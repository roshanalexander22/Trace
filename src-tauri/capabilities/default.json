{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Trace desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "window-state:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}

